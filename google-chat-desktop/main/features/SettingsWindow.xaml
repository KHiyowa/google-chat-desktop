<Window x:Class="google_chat_desktop.main.features.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Settings_Title}" Height="340" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Settings_BracketsDescription}" TextWrapping="Wrap" Margin="0,0,0,15"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="{DynamicResource Settings_OpeningBrackets}" Width="130" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtOpeningBrackets" Width="240"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="{DynamicResource Settings_ClosingBrackets}" Width="130" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtClosingBrackets" Width="240"/>
        </StackPanel>

        <TextBlock Grid.Row="3" Text="{DynamicResource Settings_IgnoredWordsDescription}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="{DynamicResource Settings_IgnoredWords}" Width="130" VerticalAlignment="Center"/>
            <TextBox x:Name="TxtIgnoredWords" Width="240"/>
        </StackPanel>

        <Grid Grid.Row="6">
            <Button Content="{DynamicResource Settings_Reset}" Click="Reset_Click" HorizontalAlignment="Left" Padding="8,3"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="{DynamicResource Settings_Save}" Click="Save_Click" Width="80" Margin="0,0,10,0"/>
                <Button Content="{DynamicResource Settings_Cancel}" Click="Cancel_Click" Width="80"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
